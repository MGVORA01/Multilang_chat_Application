# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://app_user:change_me@localhost:5432/multilingual_chat

# REQUIRED. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected at startup on purpose (a published key = forgeable logins).
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Comma-separated allowed browser origins (CORS + WebSocket Origin check)
FRONTEND_ORIGIN=http://localhost:5173

WS_TICKET_EXPIRE_SECONDS=30
WS_MESSAGES_PER_10S=20
WS_EVENTS_PER_10S=60
WS_MAX_CONNECTIONS_PER_USER=5
WS_TICKETS_PER_MINUTE=20
LOGIN_ATTEMPTS_PER_ACCOUNT_15MIN=20
TRANSLATE_RATE_LIMIT_PER_MINUTE=60
WS_IDLE_TIMEOUT_SECONDS=60
MAX_MESSAGE_LENGTH=2000

SUPPORTED_LANGUAGES=eng_Latn,guj_Gujr,hin_Deva,tam_Taml,ben_Beng,mar_Deva,tel_Telu,kan_Knda,mal_Mlym,pan_Guru,ory_Orya,asm_Beng

# indictrans2 | mock (fake "[lang] text" output, no download) | disabled
TRANSLATION_BACKEND=indictrans2
TRANSLATION_DEVICE=cpu
TRANSLATION_MAX_CONCURRENT_JOBS=1
TRANSLATION_MAX_QUEUE_SIZE=50
TRANSLATION_TIMEOUT_SECONDS=120
# Load all three checkpoints at startup (recommended). false = load on first use.
TRANSLATION_PRELOAD=true
TRANSLATION_TORCH_THREADS=4
TRANSLATION_NUM_BEAMS=3
# Keep false: IndicTrans2's model code crashes with the KV cache on transformers 4.5x
TRANSLATION_USE_CACHE=false
TRANSLATION_REPETITION_PENALTY=1.2
TRANSLATION_NO_REPEAT_NGRAM_SIZE=3

INDIC_INDIC_MODEL=ai4bharat/indictrans2-indic-indic-dist-320M
EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
# Exact commits of the model code that runs with trust_remote_code. Change only after reviewing upstream.
INDIC_INDIC_MODEL_REVISION=ffb7582b6d43791f1fb26b2153fc065f2e9ea575
EN_INDIC_MODEL_REVISION=2cfd0a20057756d756bf3e53528f492afc52f91a
INDIC_EN_MODEL_REVISION=d66a2122ad6d28184f3dc3797b652bd80ae3f65f
TRANSLATION_ADHOC_QUEUE_SHARE=0.5

# --- Production (APP_ENV=production refuses to start unless all of these are set safely) ---
# APP_ENV=production
# COOKIE_SECURE=true
# FRONTEND_ORIGIN=https://chat.example.org
# ALLOWED_HOSTS=chat.example.org
# METRICS_ENABLED=false
# Optional after first download: HF_HUB_OFFLINE=1 (never contact the Hub at runtime)

# Hugging Face credentials: do NOT put HF_TOKEN here. Run `hf auth login` once instead.
