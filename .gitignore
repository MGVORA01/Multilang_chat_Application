# ---------------------------------------------------------------- secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
# Hugging Face token / cache if ever pointed inside the project
.huggingface/
hf_token*

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------- Node / frontend
node_modules/
dist/
*.tsbuildinfo
*.local
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
